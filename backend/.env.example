# Copy to backend/.env and fill in what you have. Every value is optional —
# InfraPilot runs fully offline with none of them set.

# F4: enables the Claude tool-use planner. Without it the deterministic
# router plans the investigation instead, with an identical event stream.
ANTHROPIC_API_KEY=

# Planner model. Sonnet 5 is chosen for latency; any current model works.
PLANNER_MODEL=claude-sonnet-5

# F3: leave false to run the cascade engine in-process (the demo default).
USE_MODAL=false
MODAL_FUNCTION=infrapilot/simulate_cascade

# F6: mock returns realistic findings in the live API's shape.
OSPREY_MODE=mock

# Storage + CORS
DB_PATH=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
